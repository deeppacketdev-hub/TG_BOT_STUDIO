"""
Обробники бота збору заявок (Lead Generation).
Покроковий опитувальник із FSM (Finite State Machine).
"""

from aiogram import Router, F
from aiogram.filters import CommandStart
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.types import (
    Message,
    CallbackQuery,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
    ReplyKeyboardMarkup,
    KeyboardButton,
    ReplyKeyboardRemove,
)

from config import ADMIN_CHAT_ID

router = Router()

WELCOME_TEXT = """{{ welcome_text | default("👋 Вітаємо!\n\nЗалиште заявку, і ми зв'яжемося з вами.") }}"""
THANK_YOU_TEXT = """{{ thank_you_text | default("✅ Дякуємо! Вашу заявку прийнято.\nМи зв'яжемося з вами найближчим часом.") }}"""

# ─── Налаштування полів форми ───────────────────────────────────────
FORM_FIELDS = {{ form_fields | tojson(indent=4) }}

{% if services %}
SERVICES = {{ services | tojson }}
{% endif %}


# ─── FSM States ─────────────────────────────────────────────────────
class LeadForm(StatesGroup):
    name = State()
    phone = State()
{% if services %}
    service = State()
{% endif %}
    comment = State()
    confirm = State()


@router.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext) -> None:
    await state.clear()
    await message.answer(WELCOME_TEXT)
    await message.answer("📝 Як вас звати?")
    await state.set_state(LeadForm.name)


@router.message(LeadForm.name)
async def process_name(message: Message, state: FSMContext) -> None:
    await state.update_data(name=message.text)

    # Запитуємо телефон з кнопкою "Поділитися контактом"
    kb = ReplyKeyboardMarkup(
        keyboard=[[KeyboardButton(text="📱 Поділитися номером", request_contact=True)]],
        resize_keyboard=True,
        one_time_keyboard=True,
    )
    await message.answer("📞 Ваш номер телефону:", reply_markup=kb)
    await state.set_state(LeadForm.phone)


@router.message(LeadForm.phone, F.contact)
async def process_phone_contact(message: Message, state: FSMContext) -> None:
    await state.update_data(phone=message.contact.phone_number)
    await _ask_next_after_phone(message, state)


@router.message(LeadForm.phone)
async def process_phone_text(message: Message, state: FSMContext) -> None:
    await state.update_data(phone=message.text)
    await _ask_next_after_phone(message, state)


async def _ask_next_after_phone(message: Message, state: FSMContext) -> None:
{% if services %}
    # Показуємо вибір послуги
    buttons = []
    for svc in SERVICES:
        buttons.append([InlineKeyboardButton(text=svc, callback_data=f"svc_{svc}")])
    kb = InlineKeyboardMarkup(inline_keyboard=buttons)
    await message.answer("🔧 Оберіть послугу:", reply_markup=ReplyKeyboardRemove())
    await message.answer("👇", reply_markup=kb)
    await state.set_state(LeadForm.service)
{% else %}
    await message.answer("💬 Залиште коментар (або напишіть «—» щоб пропустити):", reply_markup=ReplyKeyboardRemove())
    await state.set_state(LeadForm.comment)
{% endif %}


{% if services %}
@router.callback_query(LeadForm.service, F.data.startswith("svc_"))
async def process_service(callback: CallbackQuery, state: FSMContext) -> None:
    service = callback.data.replace("svc_", "")
    await state.update_data(service=service)
    await callback.message.answer("💬 Залиште коментар (або напишіть «—» щоб пропустити):")
    await state.set_state(LeadForm.comment)
    await callback.answer()
{% endif %}


@router.message(LeadForm.comment)
async def process_comment(message: Message, state: FSMContext) -> None:
    comment = message.text if message.text != "—" else ""
    await state.update_data(comment=comment)

    # Підсумок перед підтвердженням
    data = await state.get_data()
    summary = (
        "📋 <b>Перевірте вашу заявку:</b>\n\n"
        f"👤 Ім'я: {data['name']}\n"
        f"📞 Телефон: {data['phone']}\n"
    )
{% if services %}
    summary += f"🔧 Послуга: {data.get('service', '—')}\n"
{% endif %}
    summary += f"💬 Коментар: {data.get('comment') or '—'}\n"

    kb = InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(text="✅ Підтвердити", callback_data="lead_confirm"),
            InlineKeyboardButton(text="❌ Скасувати", callback_data="lead_cancel"),
        ]
    ])
    await message.answer(summary, reply_markup=kb)
    await state.set_state(LeadForm.confirm)


@router.callback_query(LeadForm.confirm, F.data == "lead_confirm")
async def confirm_lead(callback: CallbackQuery, state: FSMContext) -> None:
    data = await state.get_data()
    user = callback.from_user

    # Формуємо повідомлення адміну
    admin_text = (
        "🔔 <b>Нова заявка!</b>\n\n"
        f"👤 Ім'я: {data['name']}\n"
        f"📞 Телефон: {data['phone']}\n"
    )
{% if services %}
    admin_text += f"🔧 Послуга: {data.get('service', '—')}\n"
{% endif %}
    admin_text += (
        f"💬 Коментар: {data.get('comment') or '—'}\n"
        f"{'─' * 30}\n"
        f"🆔 User ID: <code>{user.id}</code>\n"
        f"📎 @{user.username or '—'}"
    )

    try:
        await callback.bot.send_message(chat_id=ADMIN_CHAT_ID, text=admin_text)
    except Exception:
        pass  # Якщо адмін-чат недоступний, заявку все одно прийнято

    await callback.message.edit_text(THANK_YOU_TEXT)
    await state.clear()
    await callback.answer("✅ Заявку надіслано!")


@router.callback_query(LeadForm.confirm, F.data == "lead_cancel")
async def cancel_lead(callback: CallbackQuery, state: FSMContext) -> None:
    await state.clear()
    await callback.message.edit_text("❌ Заявку скасовано. Натисніть /start щоб почати знову.")
    await callback.answer()
